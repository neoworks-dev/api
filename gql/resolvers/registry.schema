// The OpenSchema public registry (openschema.neoworks.dev) database, authored in
// the OpenSchema DSL — the canonical source for the registry's own client database.
// Compiled to registry.internal.json (committed, go:embed'd) and provisioned at
// boot by SeedOpenschemaRegistry. Regenerate the JSON with: bun run gen:registry.
//
// Column names are the snake_case of each field (latestVersion -> latest_version),
// so they match the seed catalog + the openschema site's queries.
namespace registry

// Org-owned, publicly readable: the published schema catalog. Writes require the
// openschema org's confidential client; reads are anonymous.
@neoworks.kind("org") @neoworks.visibility("public")
@neoworks.unique("scope", "name")
model Schema {
  1 scope: string
  @neoworks.fulltext 2 name: string
  @neoworks.fulltext 3 description: string
  4 tags: [string]
  5 license: string
  6 repository: string
  7 latestVersion: string
  8 official: bool
  9 downloadsTotal: i64
}

@neoworks.kind("org") @neoworks.visibility("public")
@neoworks.index("schemaId")
@neoworks.unique("schemaId", "version")
model SchemaVersion {
  1 schemaId: string
  2 version: string
  3 state: string
  4 readme: string
  5 targets: [string]
  6 releasedAt: timestamp?
}

@neoworks.kind("org") @neoworks.visibility("public")
@neoworks.index("versionId")
model SchemaFile {
  1 versionId: string
  2 path: string
  3 contents: string
  4 size: i64
  5 ordinal: i64
}

// User-authored, publicly readable: any signed-in user owns their rows; everyone reads.
@neoworks.visibility("public")
@neoworks.index("schemaId")
model Discussion {
  1 schemaId: string
  2 title: string
  3 authorName: string
  4 messageCount: i64
}

@neoworks.visibility("public")
@neoworks.index("discussionId")
model Message {
  1 discussionId: string
  2 parentMessageId: string?
  3 body: string
  4 authorName: string
}

@neoworks.visibility("public")
@neoworks.index("schemaId")
model Document {
  1 schemaId: string
  2 title: string
  3 kind: string
  4 body: string?
  5 fileUrl: string?
  6 fileName: string?
  7 fileSize: i64?
  8 mime: string?
  9 authorName: string
}

// Per-user work-in-progress (private data table), promoted to a SchemaVersion on
// publish. `files` is a JSON-encoded [{path, contents}] string.
model SchemaVersionDraft {
  1 schemaScope: string
  2 schemaName: string
  3 version: string
  4 readme: string
  5 targets: [string]
  6 files: string
}

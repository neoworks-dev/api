PORT=8081
KEY_PATH=./keys/auth.pem
REDIS_URL=localhost:6379
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PRIVATE=neoworks-private
S3_BUCKET_PUBLIC=neoworks-public
S3_BUCKET_TEMP=neoworks-temp
S3_FORCE_PATH_STYLE=true
DEBUG=true

# Shared tenant SurrealDB instance. Free-plan orgs' client databases all live on
# this one instance, isolated by their per-client namespace (client_{clientID}).
# Unset = falls back to the control-plane SURREAL_* connection (single-instance dev).
# Point it at a separate instance in production so a runaway tenant query can't
# starve the control plane.
SHARED_TENANT_SURREAL_URL=
SHARED_TENANT_SURREAL_USER=root
SHARED_TENANT_SURREAL_PASS=root

# Per-query time budget for client databases (Go duration). Unset = plan-aware
# defaults (free 8s, pro 30s); setting it overrides both.
CLIENT_DB_QUERY_TIMEOUT=

# Shared-instance query admission control (Redis-coordinated, noisy-neighbour guard).
# All optional — defaults shown. A tenant whose recent query-time (decayed with the
# half-life) exceeds the cost threshold is dropped to the penalty cap.
DB_THROTTLE_FREE_CAP=4
DB_THROTTLE_PRO_CAP=8
DB_THROTTLE_PENALTY_CAP=1
DB_THROTTLE_GLOBAL_CAP=64
DB_THROTTLE_COST_THRESHOLD=5000
DB_THROTTLE_COST_HALFLIFE=30s
DB_THROTTLE_MAX_WAIT=2s

# Push notifications for sign-in approvals (optional — unset = no-op, app uses long-poll)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_TOPIC=

# Transactional email (optional — unset = no-op that logs the message).
# Dev uses a GMX account: SMTP_HOST=mail.gmx.net, SMTP_PORT=587,
# SMTP_USERNAME + SMTP_FROM = your full GMX address, SMTP_PASSWORD = your GMX password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Embeddings for the memories API (optional — unset = no-op: memories are created
# but not embedded until a server is configured). OpenAI-compatible /v1/embeddings
# endpoint — Ollama for CPU self-host, vLLM for GPU hosted. Choose the model to
# match the tier; both truncate to EMBEDDINGS_DIMENSION (1024) via Matryoshka.
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSION=1024
EMBEDDINGS_TIMEOUT_SECONDS=30
EMBEDDINGS_BATCH_SIZE=32

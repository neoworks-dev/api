PORT=8081
KEY_PATH=./keys/auth.pem
REDIS_URL=localhost:6379
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PRIVATE=neoworks-private
S3_BUCKET_PUBLIC=neoworks-public
S3_BUCKET_TEMP=neoworks-temp
S3_FORCE_PATH_STYLE=true
DEBUG=true

# Presigned blob URLs point at S3_PUBLIC_ENDPOINT (what browsers and apps can reach);
# the API itself talks to S3_ENDPOINT.
# Most bytes one owner may store (default 10 GiB).
STORAGE_QUOTA_BYTES=10737418240
# Days a deleted node's tombstone is kept before it is purged (default 30).
TOMBSTONE_RETENTION_DAYS=30

# Push notifications for sign-in approvals (optional — unset = no-op, app uses long-poll)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_TOPIC=

# Transactional email (optional — unset = no-op that logs the message).
# Dev uses a GMX account: SMTP_HOST=mail.gmx.net, SMTP_PORT=587,
# SMTP_USERNAME + SMTP_FROM = your full GMX address, SMTP_PASSWORD = your GMX password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

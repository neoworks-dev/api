PORT=8081
KEY_PATH=./keys/auth.pem
REDIS_URL=localhost:6379
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PRIVATE=neoworks-private
S3_BUCKET_PUBLIC=neoworks-public
S3_BUCKET_TEMP=neoworks-temp
S3_FORCE_PATH_STYLE=true
DEBUG=true

# Per-organization SurrealDB instances. Each org's client databases run on a
# dedicated SurrealDB container, provisioned lazily on the org's first database.
# Requires a docker daemon on the API host.
#   INSTANCE_SECRET_KEY  base64 32-byte key sealing per-instance root passwords;
#                        unset = passwords stored unencrypted (dev only).
#   TENANT_SURREAL_*     image/network/host knobs for the docker driver.
INSTANCE_SECRET_KEY=
TENANT_SURREAL_IMAGE=surrealdb/surrealdb:latest-dev
TENANT_SURREAL_NETWORK=
TENANT_SURREAL_BIND_HOST=127.0.0.1
TENANT_SURREAL_DIAL_HOST=127.0.0.1

# Push notifications for sign-in approvals (optional — unset = no-op, app uses long-poll)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_TOPIC=

# Transactional email (optional — unset = no-op that logs the message).
# Dev uses a GMX account: SMTP_HOST=mail.gmx.net, SMTP_PORT=587,
# SMTP_USERNAME + SMTP_FROM = your full GMX address, SMTP_PASSWORD = your GMX password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Embeddings for the memories API (optional — unset = no-op: memories are created
# but not embedded until a server is configured). OpenAI-compatible /v1/embeddings
# endpoint — Ollama for CPU self-host, vLLM for GPU hosted. Choose the model to
# match the tier; both truncate to EMBEDDINGS_DIMENSION (1024) via Matryoshka.
EMBEDDINGS_URL=http://localhost:11434/v1
EMBEDDINGS_MODEL=qwen3-embedding:0.6b
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSION=1024
EMBEDDINGS_TIMEOUT_SECONDS=30
EMBEDDINGS_BATCH_SIZE=32

# Local environment & secrets
.env

# Signing keys — never commit. Anchored to the root dir so it does not also
# swallow the Go source packages named `keys` (handlers/keys, tests/.../keys).
/keys/
*.pem
*.key

# Air hot-reload build artifacts
/tmp/

# Runtime data
/data/

# Compiled demo/tooling binaries
/dist/
/provisiondemo
/migrate

# Minimal runtime image for the provisioning demo. Binaries are built on the host
# with the project's Go toolchain (CGO disabled → static), so this image only
# assembles the runtime: kubectl (the provisioner shells out to it), CA certs, the
# migration SQL, and the two binaries.
FROM alpine:3.20

ARG KUBECTL_VERSION=v1.31.0

RUN apk add --no-cache ca-certificates curl \
    && curl -fsSLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && apk del curl

WORKDIR /app
COPY dist/api /usr/local/bin/api
COPY dist/migrate /usr/local/bin/migrate
COPY dist/provisiondemo /usr/local/bin/provisiondemo
COPY sql/migrations /app/sql/migrations

# Default command runs the demo; the API Deployment overrides it with `api` and
# the migration Job overrides it with `migrate`.
CMD ["/usr/local/bin/provisiondemo"]
